# ─────────────────────────────────────────────────────────────
# 연구실 회의록 자동화 설정 파일
# 이 파일을 복사한 .env 에 실제 값을 넣습니다 (프로그램을 처음 실행하면 자동 복사됨).
# 화면의 '설정' 탭에서도 수정할 수 있습니다. .env 는 절대 깃헙에 올리지 마세요.
# ─────────────────────────────────────────────────────────────

# [필수] API 키 — 구독(ChatGPT Plus, Claude Pro)과 API 요금은 별개라 각 콘솔에서 결제 등록이 필요합니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NOTION_API_KEY=

# [필수] Notion 데이터베이스 — ID 또는 데이터베이스 링크 전체
NOTION_MEETING_DATABASE_ID=
NOTION_AI_NOTES_DATABASE_ID=
# [필수] 회의록 모음 DB 에서 AI 녹취+요약본 DB 를 가리키는 Relation 속성의 '정확한' 이름
NOTION_MEETING_RELATION_PROPERTY=
# [선택] Relation 이 양방향이 아닐 때만: AI 녹취+요약본 DB 에서 회의록 모음 DB 를 가리키는 Relation 속성 이름
NOTION_AI_NOTES_RELATION_PROPERTY=
# [선택] 날짜 속성 이름 (비우면 날짜 속성은 건드리지 않음)
NOTION_MEETING_DATE_PROPERTY=
NOTION_AI_NOTES_DATE_PROPERTY=
# [선택] 회의록 모음 DB 의 '관련 프로젝트' Relation 속성 이름 (화면에서 입력한 관련 페이지와 연결)
NOTION_MEETING_PROJECT_RELATION_PROPERTY=

# [선택] 전사 설정
TRANSCRIPTION_PROVIDER=openai
# gpt-transcribe(권장) | gpt-4o-transcribe | gpt-4o-mini-transcribe | whisper-1(정확한 타임스탬프)
# | gpt-4o-transcribe-diarize(화자 A/B 구분, 용어 힌트 미지원)
TRANSCRIPTION_MODEL=gpt-transcribe
TRANSCRIPTION_LANGUAGE=ko
TRANSCRIPTION_CHUNK_SECONDS=180
TRANSCRIPTION_OVERLAP_SECONDS=8
# 연구실 용어·사람 이름 (쉼표 구분) — 전사와 회의록 정확도 향상
GLOSSARY=

# [선택] 회의록 생성 — anthropic | openai (비우면 Anthropic 키가 있으면 anthropic)
SUMMARY_PROVIDER=
# 비우면 제공자별 기본값 (anthropic: claude-opus-5-5, openai: gpt-6.1-sol)
SUMMARY_MODEL=
# low | medium | high | xhigh | max (높을수록 꼼꼼하지만 비용·시간 증가)
SUMMARY_EFFORT=high

# [선택] 저장 위치 (비우면 이 폴더 안의 recordings/ transcripts/ minutes/ logs/)
RECORDING_DIR=
TRANSCRIPT_DIR=
MINUTES_DIR=
LOG_DIR=
RECORDING_SAMPLE_RATE=16000
# 원본 녹음 보존 기간(일). 0 = 무기한. 0보다 커도 자동 삭제는 하지 않으며, 화면의 삭제 버튼을 눌렀을 때만 삭제
RETENTION_DAYS=0
